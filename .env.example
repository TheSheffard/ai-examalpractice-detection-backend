# --- MongoDB Atlas ---
# Get this from Atlas: Database > Connect > Drivers > copy the connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DB=exam_monitor

# --- Cloudinary ---
# Get these from your Cloudinary dashboard (Settings > Access Keys)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Detection thresholds (safe to leave as-is to start; tune after testing) ---
OBJECT_CONFIDENCE_THRESHOLD=0.5
POSE_HAND_DROP_SECONDS=2.0
GAZE_AWAY_SECONDS=4.0
ALERT_PERSISTENCE_FRAMES=3
FRAME_CHECK_INTERVAL_SECONDS=1.0
